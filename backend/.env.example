# =====================================================================
# GleamDream Studio 后端环境变量模板（复制为 .env 后填入真实值）
# =====================================================================
APP_NAME=GleamDream Studio
ENV=dev
API_V1_PREFIX=/api/v1

# ---- 数据库（PostgreSQL 16，asyncpg 驱动）----
DATABASE_URL=postgresql+asyncpg://postgres:your-password-here@localhost:5432/gleam-dream

# ---- JWT 认证 ----
JWT_SECRET=your-key-here-at-least-32-bytes-long
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=30

# ---- DeepSeek 模型 ----
DEEPSEEK_API_KEY=your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---- 智谱 GLM 模型 ----
GLM_API_KEY=your-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_MODEL=GLM-5.3-Flash

# ---- 本地磁盘存储（模拟 OSS）----
STORAGE_DIR=./storage

# ---- 沙箱模式（不开真实扣费/三方调用）----
SANDBOX_MODE=true

# ---- 开发环境固定短信验证码 ----
DEV_FIXED_SMS_CODE=123456

# ---- 管理端口令（埋点漏斗 / 模型配置写操作；空串表示禁用）----
ADMIN_TOKEN=your-admin-token-here

# ---- 支付回调密钥（非沙箱环境必填；HMAC-SHA256(out_trade_no|status)）----
PAYMENT_WEBHOOK_SECRET=your-webhook-secret-here

# ---- CORS 允许来源（逗号分隔；生产禁止 * + credentials 组合）----
ALLOWED_ORIGINS=http://127.0.0.1:5175,http://localhost:5175

# ---- 静态文件鉴权（生产建议 true；开启后 /files 需 Bearer 或 ?access_token=）----
FILES_REQUIRE_AUTH=false

# ---- 数据库连接池（默认 20+30；按压测校准，见 scripts/perf_smoke.py）----
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
