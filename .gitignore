# 浮光造梦 · GleamDream Studio 根级忽略规则
# 目的：防止真实密钥、用户媒体、测试产物进入版本库/交付包

# ---- 根级工具与临时产物 ----
node_modules/
.pytest_cache/
.trae/
.trae-html-share-packages/
.workbuddy/
.screenshots/
test-results/
pip-*/
gd_check_*/
gd_*.bin
gd_*.wav
下载/

# ---- 密钥与本地配置 ----
backend/.env
backend/.env.*
!backend/.env.example
**/*.pem
**/*.key

# ---- 运行时数据与日志 ----
backend/storage/
backend/logs/
backend/.uvicorn.log
backend/.pytest_run.log
*.log

# ---- Python ----
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
backend/.run/
backend/pytest-of-*/
backend/xfade_test_*/

# ---- 前端 ----
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ---- 测试/截图/演示产物 ----
frontend/e2e-verify/
frontend/public/derived/
frontend/src/assets/**/*.bak.*
测试报告/artifacts/
测试报告/前端测试截图_*/
测试报告/screenshots*/
测试报告/scripts/
vibe_images/

# ---- 大型设计素材与媒体 ----
项目开发文档/视觉设计方案/
**/*.mp4
**/*.mov

# ---- 编辑器 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
